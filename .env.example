# 1) Get a free key at https://aistudio.google.com/apikey
# 2) Copy this file to ".env" and paste the key below (no quotes, no spaces).
GEMINI_API_KEY=your_api_key_here

# ---- Optional overrides (defaults shown) --------------------------------------
# Gemini model names change over time - list: https://ai.google.dev/gemini-api/docs/models
# GEMINI_PRO_MODEL=gemini-3.1-pro-preview   # 7-day plans + feedback updates
# GEMINI_FLASH_MODEL=gemini-3.8-flash       # nutrition tips, and fallback if the Pro model fails
# GEMINI_TIMEOUT_SECONDS=90
# DATABASE_URL=sqlite:///fitbuddy.db
